# ==========================================
# Glorious Group of Schools - Environment Configuration
# ==========================================

# --- Application ---
NEXT_PUBLIC_APP_NAME="Glorious Group of Schools"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase Database & Auth ---
# For local Supabase CLI development:
# NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-local-service-role-key"

# For hosted Supabase cloud project:
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Authentication & Security ---
# Secret key used for session signing or custom JWT encryption
AUTH_SECRET="your-auth-secret-key-at-least-32-chars"

# --- Payment Gateways (Optional / Phase 2) ---
# Paystack / Flutterwave credentials for school fee collection
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."

# --- Email / Notifications (Resend) ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Glorious Group of Schools <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@gloriousschools.edu.ng"
